generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String    @id @default(uuid())
  authId    String    @unique @map("auth_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  role      Role      @default(ORTHO)
  phone     String?
  avatarUrl String?   @map("avatar_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  patients  Patient[]
  sessions  Session[]

  @@map("profiles")
}

model Patient {
  id          String           @id @default(uuid())
  firstName   String           @map("first_name")
  lastName    String           @map("last_name")
  dateOfBirth DateTime?        @map("date_of_birth")
  parentName  String?          @map("parent_name")
  parentPhone String           @map("parent_phone")
  parentEmail String?          @map("parent_email")
  monthlyFee  Float            @map("monthly_fee")
  startDate   DateTime         @map("start_date")
  notes       String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  therapistId String           @map("therapist_id")
  billings    MonthlyBilling[]
  therapist   Profile          @relation(fields: [therapistId], references: [id])
  sessions    Session[]

  @@map("patients")
}

model MonthlyBilling {
  id         String        @id @default(uuid())
  month      Int
  year       Int
  status     PaymentStatus @default(PENDING)
  amountDue  Float         @map("amount_due")
  amountPaid Float         @default(0) @map("amount_paid")
  paidAt     DateTime?     @map("paid_at")
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  patientId  String        @map("patient_id")
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, month, year])
  @@map("monthly_billings")
}

model Session {
  id          String   @id @default(uuid())
  title       String
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  notes       String?
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  patientId   String   @map("patient_id")
  therapistId String   @map("therapist_id")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist   Profile  @relation(fields: [therapistId], references: [id])

  @@map("sessions")
}

model Expense {
  id          String          @id @default(uuid())
  title       String
  category    ExpenseCategory
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

enum Role {
  ADMIN
  ORTHO
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum ExpenseCategory {
  LOYER
  SALAIRE
  MATERIEL
  MARKETING
  AUTRE
}
